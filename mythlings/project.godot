; Engine configuration file.
config_version=5

[application]

config/name="Mythlings"
config/description="A 3D creature-collecting adventure."
config/version="0.1.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.11, 0.1, 1)
boot_splash/show_image=false

[autoload]

Events="*res://scripts/core/events.gd"
DB="*res://scripts/data/database.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/saving/save_manager.gd"
Quests="*res://scripts/quests/quest_manager.gd"
Store="*res://scripts/store/store_service.gd"
Abilities="*res://scripts/creatures/ability_system.gd"
Evolution="*res://scripts/creatures/evolution_system.gd"
Audio="*res://scripts/audio/audio_manager.gd"
Router="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Nunito.ttf"

