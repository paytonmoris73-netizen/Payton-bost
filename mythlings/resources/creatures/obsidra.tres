friendship_notes = PackedStringArray("Prefers honey drop as a treat.", "Often found near The Obsidian Deep.", "Quiet and unhurried. Obsidra answers slowly, lowers its head for those it trusts, and leaves a faint ring of cooled glass wherever it has stood.", "Ability: unknown.")
discovery_hint = "Earn it by awakening Magmole through Basaltusk in the Obsidian Deep. Free, and never sold."
