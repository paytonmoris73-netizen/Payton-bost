script = ExtResource("1_s")
id = "basaltusk"
display_name = "Basaltusk"
region = "emberfall"
habitat = "The Obsidian Deep"
elements = PackedStringArray("fire", "earth")
rarity = "epic"
size_class = "large"
personality = "calm"
description = "Magmole's Awakened Form: a heavy, broad-shouldered digger about the size of a plough-ox. Six-sided basalt columns have grown into a ridged shell down its back, two long tusks of cooled volcanic glass sweep forward past its shovel jaw, and magma light shows in the joints whenever it moves."
personality_text = "Calm and deliberate. Basaltusk tests the ground before every step, leans its shoulder against anything in the way, and hums low in its chest while it digs."
