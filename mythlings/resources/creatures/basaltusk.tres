friendship_notes = PackedStringArray("Prefers honey drop as a treat.", "Often found near The Obsidian Deep.", "Calm and deliberate. Basaltusk tests the ground before every step, leans its shoulder against anything in the way, and hums low in its chest while it digs.", "Ability: unknown.")
discovery_hint = "Awaken Magmole: see its Awakening requirements."
rideable = true
