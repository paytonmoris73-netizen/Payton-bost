friendship_notes = PackedStringArray("Prefers clover cookie as a treat.", "Often found near Heartwood Hollow.", "Patient and watchful. Mossmantle climbs onto rocks to look around, sniffs every root, and settles down to let moss grow on whatever it rests against.", "Ability: unknown.")
discovery_hint = "Awaken Mossbun: see its Awakening requirements."
rideable = true
