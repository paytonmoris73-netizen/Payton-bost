# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model used for app generation. Defaults to claude-sonnet-5.
# Other options: claude-opus-5, claude-fable-5, claude-haiku-4-5-20251001
BUNNYX_MODEL=claude-sonnet-5

# Optional: port for the API/production server. Defaults to 8787.
PORT=8787
